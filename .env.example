# Copy this file to .env and fill in ONE of the provider keys.

# Option A — OpenRouter (default base URL)
OPENROUTER_API_KEY=sk-or-your-key-here

# Option B — Google Gemini (free tier: ~250 requests/day)
# Uncomment all three to use Gemini instead:
# OPENROUTER_API_KEY=
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# GEMINI_API_KEY=your-gemini-key-here
# CLASSIFIER_MODEL=gemini-2.5-flash
# ASSISTANT_MODEL=gemini-2.5-flash
